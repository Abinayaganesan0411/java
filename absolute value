import java.util.*;

public class Main {
    public static void main(String[] args) {
     Scanner sc=new Scanner(System.in);
     int num=sc.nextInt();
     int absValue;
     if(num<0){
       absValue=-num;
     }
     else{
       absValue=num;
     }
     System.out.println(+ absValue);
    }
}
